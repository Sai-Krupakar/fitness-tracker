# Server-side only (set in Vercel project settings, or a local .env for `vercel dev`)
GEMINI_API_KEY=your-gemini-api-key-here

# Client build-time variable (used by src/main.ts). Set this to your deployed
# Vercel URL, e.g. https://your-project.vercel.app — required for the Android
# APK build since it loads bundled local files, not the Vercel domain.
VITE_API_BASE_URL=https://your-project.vercel.app
