{
  "name": "solo-levelling",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test:runs": "playwright test tests/run-persistence.spec.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android",
