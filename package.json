  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@playwright/test": "^1.64.1",
    "@vercel/node": "^9.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@types/leaflet": "^1.9.22",
    "firebase": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide": "^1.61.0"
  }
}
